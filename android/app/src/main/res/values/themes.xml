<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One theme for every screen; light/dark colours come from values/ and values-night/ colors.xml. -->
    <style name="Theme.AISwitchboard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorError">@color/brand_error</item>
    </style>

    <!-- A label on the left and a button on the right (schedule rows in the settings screen). Size attributes stay in the layout, because Android ignores them inside styles. -->
    <style name="SettingsRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="SettingsRowLabel">
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>
</resources>
